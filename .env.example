# Copy to .env and fill in. Never commit .env.

# P1 (Pantheon Content Publisher) — required
NEXT_PUBLIC_CSS_SITE_ID=
CSS_API_KEY=
# Required: the P1 auth routes have no default and return 500 "Server configuration error" if blank.
# Production P1 backend; change only to target a staging/local backend.
NEXT_PUBLIC_CSS_BASE_URL=https://ccr.p1.pantheon.io

# Audio bucket (Cloudflare R2) — read-only token, used server-side to list tracks
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_AUDIO_BASE_URL=https://music.paris.jazzsequence.com
