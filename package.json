{
  "name": "paris-site-starter",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/copy-maplibre-worker.mjs && next build && pnpm copy-standalone",
    "copy-standalone": "cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
    "clean": "rm -rf .next out *.tsbuildinfo node_modules/.vite",
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node .next/standalone/server.js",
    "sync:registry": "tsx scripts/sync-puck-registry.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:a11y": "playwright test",
    "test:e2e": "playwright test",
    "storybook": "node scripts/copy-maplibre-worker.mjs && storybook dev -p 6006",
    "build-storybook": "node scripts/copy-maplibre-worker.mjs && storybook build -o storybook-static"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/unifrakturcook": "^5.3.0",
    "@pantheon-systems/cpub-react-sdk": "^5.2.1",
    "@pantheon-systems/css-client": "^0.20.1",
    "@pantheon-systems/nextjs-cache-handler": "0.13.0",
    "@pantheon-systems/p1-media": "^0.5.0",
    "@pantheon-systems/p1-next-sdk": "^0.20.1",
    "@pantheon-systems/pds-toolkit-react": "2.0.0-beta.7",
    "@pantheon-systems/puck-css": "^0.20.1",
    "@puckeditor/core": "^0.23.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.16",
    "aws4fetch": "^1.0.20",
    "classnames": "^2.5.1",
    "maplibre-gl": "6.13.0",
    "next": "^16.4.2",
    "postcss": "^8.5.25",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@atproto/api": "^0.27.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.27.0",
    "@fontsource/encode-sans-expanded": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/nextjs-vite": "^10.6.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "storybook": "^10.6.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.5"
  },
  "p1": {
    "templateVersion": "0.20.1"
  },
  "packageManager": "pnpm@10.13.1"
}
